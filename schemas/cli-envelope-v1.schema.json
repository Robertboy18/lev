{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lev versioned CLI JSON envelope",
  "description": "The common outer shape emitted by every lev command with --json.",
  "type": "object",
  "required": [
    "schema",
    "data"
  ],
  "properties": {
    "schema": {
      "description": "The command-specific compatibility contract.",
      "enum": [
        "lev.cli.cache.gc/v2",
        "lev.cli.cache.status/v2",
        "lev.cli.check/v2",
        "lev.cli.doctor/v2",
        "lev.cli.inspect.build/v2"
      ]
    },
    "data": {
      "description": "The payload defined by the schema identifier."
    }
  },
  "additionalProperties": false
}
